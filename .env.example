# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # سيرفر فقط!
SUPABASE_ACCESS_TOKEN=              # CLI / gen types فقط

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=                  # سيرفر فقط
CLOUDINARY_API_SECRET=               # سيرفر فقط

# Lemon Squeezy
LEMON_SQUEEZY_API_KEY=               # سيرفر فقط
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=            # ID الخطة الشهرية 99 MAD
LEMON_SQUEEZY_WEBHOOK_SECRET=        # لتحقق Webhook signatures

# App — canonical site URL. Use the custom domain in production.
# Local dev: http://localhost:3000 · Production: https://chofkhdemti.com
NEXT_PUBLIC_APP_URL=https://chofkhdemti.com

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXX   # معرّف الناشر (Publisher ID)
NEXT_PUBLIC_ADSENSE_FEED_SLOT=XXXXXXXXXX         # معرّف وحدة الإعلان في الفيد (Ad unit / slot ID)

# Official platform account (optional)
# UUID of the official "Chof Khdemti" account. If unset, it is resolved by the
# reserved username 'ChofKhdemti'. Its posts/stories are pinned globally.
NEXT_PUBLIC_OFFICIAL_ACCOUNT_ID=
